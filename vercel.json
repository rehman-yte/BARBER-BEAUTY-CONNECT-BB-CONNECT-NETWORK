{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.ts": {
      "includeFiles": "*.{csv,json}"
    }
  },
  "rewrites": [
    { "source": "/api/razorpay/create-order", "destination": "/api/razorpay/create-order.js" },
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
