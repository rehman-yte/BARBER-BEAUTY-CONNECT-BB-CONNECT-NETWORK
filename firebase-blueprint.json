{
  "entities": {
    "User": {
      "title": "User",
      "description": "Unified user profile for Customers, Partners, and Admins",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "partner", "admin"] },
        "status": { "type": "string", "enum": ["active", "pending", "inactive"] },
        "onboardingComplete": { "type": "boolean" },
        "brandName": { "type": "string" },
        "walletBalance": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "WalletTransaction": {
      "title": "WalletTransaction",
      "description": "Customer wallet credit/debit transaction log",
      "type": "object",
      "properties": {
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["CREDIT", "DEBIT"] },
        "status": { "type": "string", "enum": ["CREDIT", "DEBIT", "SUCCESS", "FAILED"] },
        "description": { "type": "string" },
        "bookingId": { "type": "string" },
        "reason": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["amount", "status"]
    },
    "Partner": {
      "title": "Partner",
      "description": "Business partner (salon/barber) information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "ownerName": { "type": "string" },
        "brandName": { "type": "string" },
        "mobileNumber": { "type": "string" },
        "category": { "type": "string", "enum": ["Barber", "Beauty Parlour"] },
        "workerQuantity": { "type": "integer" },
        "address": { "type": "string" },
        "upiId": { "type": "string" },
        "coords": { "type": "object" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "active"] },
        "adminApproved": { "type": "boolean" },
        "shopStatus": { "type": "string", "enum": ["open", "closed"] },
        "services": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["brandName", "status"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Service booking information",
      "type": "object",
      "properties": {
        "customerId": { "type": "string" },
        "partnerId": { "type": "string" },
        "shopId": { "type": "string" },
        "serviceName": { "type": "string" },
        "price": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Accepted", "Rejected", "Completed", "payment_held", "settlement_due"] },
        "workerName": { "type": "string" },
        "appointmentDate": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerId", "partnerId", "status"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer orders/purchases",
      "type": "object",
      "properties": {
        "customerId": { "type": "string" },
        "shopId": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Notification": {
      "title": "Notification",
      "description": "System or user notifications",
      "type": "object",
      "properties": {
        "message": { "type": "string" },
        "target": { "type": "string" },
        "type": { "type": "string" },
        "timestamp": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "MarketplaceProduct": {
      "title": "MarketplaceProduct",
      "description": "Dropshipped products on live marketplace catalog",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "sourceUrl": { "type": "string" },
        "imageUrl": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "discount": { "type": "number" },
        "rating": { "type": "number" },
        "reviews": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price"]
    },
    "SupportComplaint": {
      "title": "SupportComplaint",
      "description": "User raised complaints categorized for Customers and Partners",
      "type": "object",
      "properties": {
        "complaintId": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string", "enum": ["customer", "partner"] },
        "category": { "type": "string", "enum": ["customer", "partner"] },
        "issueType": { "type": "string" },
        "subject": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "in_progress", "resolved"] },
        "adminReply": { "type": "string" },
        "repliedAt": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userRole", "category", "description", "status"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Chat bot conversation message for persistent support thread",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sender": { "type": "string", "enum": ["user", "ai", "admin"] },
        "text": { "type": "string" },
        "timestamp": { "type": "number" },
        "isComplaint": { "type": "boolean" },
        "complaintId": { "type": "string" }
      },
      "required": ["sender", "text", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Unified user profiles"
    },
    "/users/{userId}/wallet_transactions/{transactionId}": {
      "schema": "WalletTransaction",
      "description": "Customer wallet transactions history log"
    },
    "/partners/{partnerId}": {
      "schema": "Partner",
      "description": "Business profiles (Shops)"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Service appointments"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders"
    },
    "/notifications/{notifId}": {
      "schema": "Notification",
      "description": "System-wide and targeted notifications"
    },
    "/settings/{settingId}": {
      "schema": { "type": "object" },
      "description": "Global config like platform fees"
    },
    "/admins/{adminId}": {
      "schema": { "type": "object", "properties": { "email": { "type": "string" } } },
      "description": "Authorized administrators"
    },
    "/live_marketplace/{productId}": {
      "schema": "MarketplaceProduct",
      "description": "Admin dropship products catalog entries"
    },
    "/support_complaints/{complaintId}": {
      "schema": "SupportComplaint",
      "description": "Customer and Partner complaints submitted to Admin"
    },
    "/support_chats/{userId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Permanent AI chatbot conversation history and admin reply thread"
    }
  }
}
