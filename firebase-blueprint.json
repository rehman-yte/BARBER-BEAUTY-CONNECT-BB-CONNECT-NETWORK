{
  "entities": {
    "Partner": {
      "title": "Partner",
      "description": "Business partner (salon/barber) information",
      "type": "object",
      "properties": {
        "ownerName": { "type": "string" },
        "brandName": { "type": "string" },
        "mobileNumber": { "type": "string" },
        "category": { "type": "string", "enum": ["Barber", "Beauty Parlour"] },
        "workerQuantity": { "type": "integer" },
        "address": { "type": "string" },
        "upiId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "shopStatus": { "type": "string", "enum": ["open", "closed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerName", "brandName", "status"]
    },
    "Customer": {
      "title": "Customer",
      "description": "User information for customers",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["customer"] },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Booking": {
      "title": "Booking",
      "description": "Service booking information",
      "type": "object",
      "properties": {
        "customerId": { "type": "string" },
        "shopId": { "type": "string" },
        "serviceName": { "type": "string" },
        "price": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/partners/{partnerId}": {
      "schema": "Partner",
      "description": "Salon/Barber business profiles"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Customer profiles"
    },
    "/users/{userId}": {
      "schema": "Customer",
      "description": "Legacy/Unified user profiles"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Service appointments"
    },
    "/notifications/{notifId}": {
      "schema": { "type": "object", "properties": { "message": { "type": "string" }, "target": { "type": "string" } } },
      "description": "System notifications"
    },
    "/settings/{settingId}": {
      "schema": { "type": "object" },
      "description": "Global application settings"
    }
  }
}
