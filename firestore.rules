rules_version = '2';

/* SECURITY_LAYER_LOCKED */

service cloud.firestore {
  match /databases/{database}/documents {
    
    // -------------------------------------------------------------------------
    // 0. GLOBAL SAFETY NET & HELPERS
    // -------------------------------------------------------------------------
    
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      // For this app, we trust standard auth for now, but strict rule would be:
      // return request.auth.token.email_verified == true;
      return isSignedIn();
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'haidartheworldking@gmail.com'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // -------------------------------------------------------------------------
    // 1. USERS COLLECTION
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin() || isSignedIn();
      
      match /wallet_transactions/{txId} {
        allow read, write: if isOwner(userId) || isAdmin() || isSignedIn();
      }
    }

    match /customers/{userId} {
      allow read, write: if isOwner(userId) || isAdmin() || isSignedIn();
      
      match /wallet_transactions/{txId} {
        allow read, write: if isOwner(userId) || isAdmin() || isSignedIn();
      }
    }

    // -------------------------------------------------------------------------
    // 2. PARTNERS (SHOPS) COLLECTION
    // -------------------------------------------------------------------------

    match /partners/{partnerId} {
      allow read: if true;

      function isValidPartner(data) {
        return data.keys().hasAll(['brandName', 'status']) &&
               data.brandName is string && data.brandName.size() <= 100 &&
               data.status in ['pending', 'approved', 'rejected', 'active'] &&
               (data.get('ownerName', '') is string) &&
               (data.get('mobileNumber', '') is string);
      }

      allow create: if isSignedIn() && isOwner(partnerId) && isValidPartner(incoming()) && (
        // New shops must start as pending
        incoming().status == 'pending' &&
        incoming().adminApproved == false
      );

      allow update: if isOwner(partnerId) || isAdmin() || (
        isSignedIn() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'rating', 'stars', 'totalRatings', 'ratingCount', 'reviews', 'lastRating'
        ])
      );
      
      allow delete: if isAdmin();

      match /services/{serviceId} {
        allow read, write: if true;
      }
    }

    match /verification_queue/{partnerId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // 3. BOOKINGS COLLECTION
    // -------------------------------------------------------------------------

    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // 4. ORDERS COLLECTION
    // -------------------------------------------------------------------------

    match /orders/{orderId} {
      allow read, write: if true;
    }

    match /customer_orders/{orderId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // 5. NOTIFICATIONS COLLECTION
    // -------------------------------------------------------------------------

    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // 6. SETTINGS COLLECTION
    // -------------------------------------------------------------------------

    match /settings/{settingId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // 7. ADMINS COLLECTION
    // -------------------------------------------------------------------------

    match /admins/{adminId} {
      allow read: if true;
      allow write: if true;
    }

    // -------------------------------------------------------------------------
    // 8. PAYMENT VERIFICATION & PAYOUT REQUESTS COLLECTIONS
    // -------------------------------------------------------------------------

    match /Payment_Verification/{verificationId} {
      allow read, write: if true;
    }

    match /payout_requests/{requestId} {
      allow read, write: if true;
    }

    match /partner_settlements/{settlementId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // 9. LIVE MARKETPLACE & INVENTORY COLLECTION (ADMIN DROPSHIP ENGINE BOOST)
    // -------------------------------------------------------------------------

    match /live_marketplace/{productId} {
      allow read, write: if true;
    }

    match /inventory/{itemId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // 10. REVIEWS & RATINGS COLLECTIONS
    // -------------------------------------------------------------------------

    match /Reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 11. SUPPORT COMPLAINTS & AI CHATBOT PERSISTENCE
    // -------------------------------------------------------------------------

    match /support_complaints/{complaintId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || isSignedIn();
    }

    match /support_chats/{userId} {
      allow read, write: if isSignedIn();
      
      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }
  }
}
