rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. GLOBAL SAFETY NET
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------
    // HELPER FUNCTIONS
    // ---------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "haidartheworldking@gmail.com" || 
        request.auth.token.email == "rhfarooqui16@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isStaticAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "haidartheworldking@gmail.com" || 
        request.auth.token.email == "rhfarooqui16@gmail.com"
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // ---------------------------------------------------------------
    // PARTNERS COLLECTION
    // ---------------------------------------------------------------
    match /partners/{partnerId} {
      function isValidPartner(data) {
        return data.keys().hasAll(['ownerName', 'brandName', 'status']) &&
               data.ownerName is string && data.ownerName.size() <= 200 &&
               data.brandName is string && data.brandName.size() <= 200 &&
               data.status in ['pending', 'approved', 'rejected', 'active'] &&
               (data.mobileNumber == null || (data.mobileNumber is string && data.mobileNumber.size() <= 30));
      }

      // Public profile view & discovery
      allow get: if true; 
      allow list: if true; 

      // Creation by the user for themselves
      allow create: if isOwner(partnerId) && isValidPartner(incoming()) && incoming().status == 'pending';

      // Updates by owner or admin
      allow update: if (isOwner(partnerId) && isValidPartner(incoming()) && (
        // Regular partners can only change non-RBAC fields
        incoming().diff(existing()).affectedKeys().hasOnly([
          'ownerName', 'brandName', 'mobileNumber', 'address', 'category', 'workerQuantity', 
          'upiId', 'coords', 'services', 'shopStatus', 'updatedAt', 'status', 'adminApproved'
        ]) &&
        // Protect status escalation
        (incoming().status == existing().status || incoming().status == 'pending') &&
        (incoming().adminApproved == existing().adminApproved || incoming().adminApproved == false)
      )) || isAdmin();

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // CUSTOMERS COLLECTION
    // ---------------------------------------------------------------
    match /customers/{customerId} {
      allow get: if isOwner(customerId) || isAdmin();
      allow list: if isOwner(customerId) || isStaticAdmin();
      allow create: if isOwner(customerId);
      allow update: if isOwner(customerId) || isAdmin();
    }

    // ---------------------------------------------------------------
    // USERS COLLECTION (Legacy/Unified)
    // ---------------------------------------------------------------
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isStaticAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
    }

    // ---------------------------------------------------------------
    // BOOKINGS COLLECTION
    // ---------------------------------------------------------------
    match /bookings/{bookingId} {
      // Security Boundary Enforcement
      allow get: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.partnerId == request.auth.uid || resource.data.shopId == request.auth.uid || isAdmin());
      
      // Rule 8: Secure List Queries
      allow list: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.partnerId == request.auth.uid || resource.data.shopId == request.auth.uid || isStaticAdmin());

      allow create: if isSignedIn() && incoming().customerId == request.auth.uid;
      
      allow update: if isSignedIn() && (
        (existing().customerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
        (existing().partnerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
        (existing().shopId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // NOTIFICATIONS COLLECTION
    // ---------------------------------------------------------------
    match /notifications/{notifId} {
      // Targeted list queries only. Using explicit comparison for query optimization.
      allow list: if isSignedIn() && (
        resource.data.target == 'all' || 
        resource.data.target == request.auth.uid || 
        resource.data.target == 'partners' || 
        resource.data.target == 'customers' || 
        resource.data.target == 'admin'
      );
      allow get: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // SETTINGS COLLECTION
    // ---------------------------------------------------------------
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // ADMINS COLLECTION
    // ---------------------------------------------------------------
    match /admins/{adminId} {
      allow get: if isAdmin();
      allow list: if isStaticAdmin();
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // PRODUCTS & ORDERS (Commerce)
    // ---------------------------------------------------------------
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow get: if isOwner(resource.data.customerId) || isAdmin();
      allow list: if isOwner(resource.data.customerId) || isStaticAdmin();
      allow create: if isSignedIn() && incoming().customerId == request.auth.uid;
      allow update: if isAdmin();
    }
  }
}
