rules_version = '2';

/* SECURITY_LAYER_LOCKED */

service cloud.firestore {
  match /databases/{database}/documents {
    
    // -------------------------------------------------------------------------
    // 0. GLOBAL SAFETY NET & HELPERS
    // -------------------------------------------------------------------------
    
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      // For this app, we trust standard auth for now, but strict rule would be:
      // return request.auth.token.email_verified == true;
      return isSignedIn();
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'haidartheworldking@gmail.com'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // -------------------------------------------------------------------------
    // 1. USERS COLLECTION
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      function isValidUser(data) {
        return data.keys().hasAll(['role']) && 
               data.role in ['customer', 'partner', 'admin'] &&
               (data.get('email', '') is string);
      }

      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming());
      
      allow update: if (isOwner(userId) || isAdmin()) && (
        // Prevent role escalation for non-admins
        (isAdmin() || (incoming().role == existing().role)) &&
        // General validation
        isValidUser(incoming())
      );
    }

    // -------------------------------------------------------------------------
    // 2. PARTNERS (SHOPS) COLLECTION
    // -------------------------------------------------------------------------

    match /partners/{partnerId} {
      // Anyone can read approved shops, but only owner or admin can read private details
      // Note: For simplicity and list queries, we allow reading if approved or owner
      allow get: if (existing().status == 'approved' || existing().adminApproved == true || isOwner(partnerId) || isAdmin());
      allow list: if (resource.data.status == 'approved' || resource.data.adminApproved == true || resource.data.uid == request.auth.uid || isAdmin());

      function isValidPartner(data) {
        return data.keys().hasAll(['brandName', 'status']) &&
               data.brandName is string && data.brandName.size() <= 100 &&
               data.status in ['pending', 'approved', 'rejected', 'active'] &&
               (data.get('ownerName', '') is string) &&
               (data.get('mobileNumber', '') is string);
      }

      allow create: if isSignedIn() && isOwner(partnerId) && isValidPartner(incoming()) && (
        // New shops must start as pending
        incoming().status == 'pending' &&
        incoming().adminApproved == false
      );

      allow update: if isOwner(partnerId) || isAdmin() || (
        isSignedIn() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'rating', 'stars', 'totalRatings', 'ratingCount', 'reviews', 'lastRating'
        ])
      );
      
      allow delete: if isAdmin();

      match /services/{serviceId} {
        allow read, write: if true;
      }
    }

    // -------------------------------------------------------------------------
    // 3. BOOKINGS COLLECTION
    // -------------------------------------------------------------------------

    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // 4. ORDERS COLLECTION
    // -------------------------------------------------------------------------

    match /orders/{orderId} {
      allow read, write: if true;
    }

    match /customer_orders/{orderId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // 5. NOTIFICATIONS COLLECTION
    // -------------------------------------------------------------------------

    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // 6. SETTINGS COLLECTION
    // -------------------------------------------------------------------------

    match /settings/{settingId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // 7. ADMINS COLLECTION
    // -------------------------------------------------------------------------

    match /admins/{adminId} {
      allow read: if true;
      allow write: if true;
    }

    // -------------------------------------------------------------------------
    // 8. PAYMENT VERIFICATION COLLECTION
    // -------------------------------------------------------------------------

    match /Payment_Verification/{verificationId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // 9. LIVE MARKETPLACE & INVENTORY COLLECTION (ADMIN DROPSHIP ENGINE BOOST)
    // -------------------------------------------------------------------------

    match /live_marketplace/{productId} {
      allow read, write: if true;
    }

    match /inventory/{itemId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // 10. REVIEWS & RATINGS COLLECTIONS
    // -------------------------------------------------------------------------

    match /Reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}
