rules_version = '2';

/* SECURITY_LAYER_LOCKED */

service cloud.firestore {
  match /databases/{database}/documents {
    
    // -------------------------------------------------------------------------
    // 0. GLOBAL SAFETY NET & HELPERS
    // -------------------------------------------------------------------------
    
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      // For this app, we trust standard auth for now, but strict rule would be:
      // return request.auth.token.email_verified == true;
      return isSignedIn();
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'haidartheworldking@gmail.com' ||
        request.auth.token.email == 'rhfarooqui16@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // -------------------------------------------------------------------------
    // 1. USERS COLLECTION
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      function isValidUser(data) {
        return data.keys().hasAll(['role']) && 
               data.role in ['customer', 'partner', 'admin'] &&
               (data.get('email', '') is string);
      }

      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming());
      
      allow update: if (isOwner(userId) || isAdmin()) && (
        // Prevent role escalation for non-admins
        (isAdmin() || (incoming().role == existing().role)) &&
        // General validation
        isValidUser(incoming())
      );
    }

    // -------------------------------------------------------------------------
    // 2. PARTNERS (SHOPS) COLLECTION
    // -------------------------------------------------------------------------

    match /partners/{partnerId} {
      // Anyone can read approved shops, but only owner or admin can read private details
      // Note: For simplicity and list queries, we allow reading if approved or owner
      allow get: if (existing().status == 'approved' || existing().adminApproved == true || isOwner(partnerId) || isAdmin());
      allow list: if (resource.data.status == 'approved' || resource.data.adminApproved == true || resource.data.uid == request.auth.uid || isAdmin());

      function isValidPartner(data) {
        return data.keys().hasAll(['brandName', 'status']) &&
               data.brandName is string && data.brandName.size() <= 100 &&
               data.status in ['pending', 'approved', 'rejected', 'active'] &&
               (data.get('ownerName', '') is string) &&
               (data.get('mobileNumber', '') is string);
      }

      allow create: if isSignedIn() && isOwner(partnerId) && isValidPartner(incoming()) && (
        // New shops must start as pending
        incoming().status == 'pending' &&
        incoming().adminApproved == false
      );

      allow update: if (isOwner(partnerId) || isAdmin()) && (
        isValidPartner(incoming()) && (
          // Admin can change anything
          isAdmin() || (
            // Partner can only change specific fields and CANNOT approve themselves
            incoming().status == existing().status &&
            incoming().adminApproved == existing().adminApproved &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'ownerName', 'brandName', 'mobileNumber', 'address', 'category', 
              'workerQuantity', 'upiId', 'coords', 'services', 'shopStatus', 
              'updatedAt', 'ownerPicture', 'govId', 'brandImages', 'workerImages',
              'onboardingComplete'
            ])
          )
        )
      );
      
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 3. BOOKINGS COLLECTION
    // -------------------------------------------------------------------------

    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (
        resource.data.customerId == request.auth.uid || 
        resource.data.partnerId == request.auth.uid || 
        isAdmin()
      );

      function isValidBooking(data) {
        return data.keys().hasAll(['customerId', 'partnerId', 'status']) &&
               data.customerId is string && data.partnerId is string &&
               data.status in ['Pending', 'Accepted', 'Rejected', 'Completed', 'payment_held', 'settlement_due'];
      }

      allow create: if isSignedIn() && (incoming().customerId == request.auth.uid) && isValidBooking(incoming());
      
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.customerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status'])) ||
        (resource.data.partnerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'workerName']))
      );
      
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 4. ORDERS COLLECTION
    // -------------------------------------------------------------------------

    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.customerId == request.auth.uid || 
        resource.data.shopId == request.auth.uid || 
        isAdmin()
      );

      allow create: if isSignedIn() && (incoming().customerId == request.auth.uid);
      allow update: if isSignedIn() && (isAdmin() || resource.data.customerId == request.auth.uid || resource.data.shopId == request.auth.uid);
    }

    // -------------------------------------------------------------------------
    // 5. NOTIFICATIONS COLLECTION
    // -------------------------------------------------------------------------

    match /notifications/{notifId} {
      // In logic_engine, notifications are queried with 'target' in ['all', role, userId]
      allow read: if isSignedIn() && (
        resource.data.target == 'all' || 
        resource.data.target == request.auth.uid ||
        // Check user role from /users/$(request.auth.uid) if needed, but 'target' is enough for targeted pings
        resource.data.target == 'customers' || 
        resource.data.target == 'partners' ||
        isAdmin()
      );

      // System writes notifications, but we allow partners to send limited pings if the app supports it
      // For now, only Admin or system can bulk write
      allow create: if isAdmin() || (isSignedIn() && incoming().target != 'all');
    }

    // -------------------------------------------------------------------------
    // 6. SETTINGS COLLECTION
    // -------------------------------------------------------------------------

    match /settings/{settingId} {
      allow read: if true; // Public config
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 7. ADMINS COLLECTION
    // -------------------------------------------------------------------------

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false; // Managed via Console
    }

    // -------------------------------------------------------------------------
    // 8. PAYMENT VERIFICATION COLLECTION
    // -------------------------------------------------------------------------

    match /Payment_Verification/{verificationId} {
      allow read: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (incoming().customerId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 9. MARKETPLACE PRODUCTS COLLECTION
    // -------------------------------------------------------------------------

    match /marketplace_products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
