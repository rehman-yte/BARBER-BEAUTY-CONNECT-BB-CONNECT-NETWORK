rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. GLOBAL CATCH-ALL
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. SIMPLE LOCK: Users can read/write their own document in ANY collection
    // This stops "Insufficient Permissions" for profiles and discovery
    match /partners/{userId} {
      allow read: if true; // Public discovery
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /customers/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. BOOKINGS: Customers create, Partners manage
    match /bookings/{bookingId} {
      allow read: if request.auth != null && (resource.data.customerId == request.auth.uid || resource.data.shopId == request.auth.uid);
      allow create: if request.auth != null;
      allow update: if request.auth != null && (resource.data.customerId == request.auth.uid || resource.data.shopId == request.auth.uid);
      allow delete: if request.auth != null && (resource.data.customerId == request.auth.uid || resource.data.shopId == request.auth.uid);
    }

    // 3. SETTINGS & NOTIFICATIONS: Open read, Admin write
    match /notifications/{nodeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; // Simpler for now
    }

    match /settings/{nodeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
